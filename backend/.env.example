# =============================================================================
# LogSherlock — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# Every value below is a documented starting default, not a measured guarantee.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_NAME=LogSherlock
LOG_LEVEL=INFO

# --- Network -----------------------------------------------------------------
# CORS is restricted to this origin only. Do not use "*" in production.
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Persistence -------------------------------------------------------------
DATABASE_URL=sqlite:///./logsherlock.db
# Raw log input is NOT persisted by default (SPEC §11.5). Flip only knowingly.
PERSIST_RAW_LOGS=false

# =============================================================================
# Model provider (SPEC §4.3, §9.4)
# -----------------------------------------------------------------------------
# MODEL_PROVIDER selects the implementation:
#   ollama      -> ChatOllama       (local Ollama daemon, privacy-first)
#   google      -> ChatGoogle       (Google AI Studio, Gemma family)
#   openai      -> ChatOpenAI       (api.openai.com)
#   openai_compat -> ChatOpenAICompat (OpenRouter, vLLM, LM Studio, llama.cpp)
#
# Nothing is sent to any provider that is not explicitly configured here.
# No external fallback exists.
# =============================================================================
MODEL_PROVIDER=ollama

# --- ollama ---
# Leave MODEL_BASE_URL unset to use Ollama's default (http://localhost:11434).
# Uncomment only if you run Ollama somewhere non-standard.
# MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=your-tested-model-id
# Ollama needs no credential; a placeholder keeps the config uniform.
MODEL_API_KEY=

# --- google ---
# Google AI Studio key. Required when MODEL_PROVIDER=google.
# Gemma weights are open-weight, but this provider is HOSTED: redacted evidence
# leaves the machine. Set this only if you accept that.
# MODEL_API_KEY=your-google-ai-studio-key

# --- openai / openai_compat ---
# openai         -> https://api.openai.com/v1 (the default; needs a key)
# openai_compat  -> any OpenAI-shaped endpoint; set both values:
# MODEL_API_KEY=sk-...
# MODEL_BASE_URL=https://openrouter.ai/api/v1

# Timeout applied to every inference request.
#
# A thinking model (Gemma 4 and similar) spends most of its time reasoning
# before answering. The budget below covers BOTH reasoning and the answer:
#
#   context length  !=  output budget
#   256k context    =  how much log evidence you can feed in
#   OUTPUT tokens    =  how long it may think before it must answer
#
# Raise this when findings come back empty and the report says the budget was
# exhausted. It is not a substitute for a faster model.
MODEL_TIMEOUT_SECONDS=90
# Sampling controls. Low temperature keeps report structure predictable.
MODEL_TEMPERATURE=0.1
# Keep this comfortably above the reasoning phase. 8192 was not enough for
# gemma-4-26b-a4b-it, which spent the entire budget reasoning and returned
# nothing.
MODEL_MAX_OUTPUT_TOKENS=16384
# Pause before each model call, jittered. Calls run one at a time: a burst
# of identical requests on one key is what invites rate limits. Set to 0
# under APP_ENV=test.
MODEL_CALL_STAGGER_SECONDS=1.5

# Leave unset. Several Gemma builds reject a thinking_config outright with
# "Thinking budget is not supported for this model", so sending one is worse
# than sending none.
# MODEL_THINKING_BUDGET=0

# =============================================================================
# Input limits (SPEC §7.2). Return HTTP 413 when exceeded.
# =============================================================================
MAX_UPLOAD_MB=5
MAX_LOG_LINES=20000
MAX_LINE_LENGTH=20000
MAX_EVIDENCE_CHARS=16000
MAX_CONCURRENT_INVESTIGATIONS=2
# Total groups sent to the model; the rest are summarised deterministically.
MAX_GROUPS_FOR_MODEL=8

# =============================================================================
# Redaction (SPEC §12.2)
# =============================================================================
REDACTION_ENABLED=true
# Best-effort only — regex redaction cannot guarantee secret detection.
REDACT_IP_ADDRESSES=true
