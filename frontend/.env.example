# =============================================================================
# LogSherlock frontend configuration
# =============================================================================
# Copy to `.env.local` and edit:
#     cp .env.example .env.local
#
# Next.js loads `.env*` from the project root (frontend/), not from src/.
# Only variables prefixed with NEXT_PUBLIC_ reach the browser — which is why
# this file contains no secrets. The API key lives in backend/.env instead.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined at BUILD time. After `next build`,
# changing this value has no effect until you rebuild.
# -----------------------------------------------------------------------------

# Base URL of the LogSherlock backend, without a trailing slash.
# Must be reachable from the browser, not just from your shell.
#
#   Local dev ....... http://127.0.0.1:8000
#   Deployed backend . https://logsherlock.example.com
#
# This origin must also be allowed by the backend's FRONTEND_ORIGIN setting
# (backend/.env), or the browser will block every request as a CORS error.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000